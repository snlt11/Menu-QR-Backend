    {
      "name": "Kitchen",
      "item": [
        {
          "name": "List Kitchen Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/t/{{tenant_slug}}/kitchen/orders", "host": ["{{base_url}}"], "path": ["api", "t", "{{tenant_slug}}", "kitchen", "orders"] }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/t/{{tenant_slug}}/kitchen/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["api", "t", "{{tenant_slug}}", "kitchen", "orders", "{{order_id}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"preparing\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Cashier",
      "item": [
        {
          "name": "List Unpaid Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/t/{{tenant_slug}}/cashier/orders", "host": ["{{base_url}}"], "path": ["api", "t", "{{tenant_slug}}", "cashier", "orders"] }
          }
        },
        {
          "name": "Generate Bill (QR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/t/{{tenant_slug}}/cashier/orders/{{order_id}}/bill", "host": ["{{base_url}}"], "path": ["api", "t", "{{tenant_slug}}", "cashier", "orders", "{{order_id}}", "bill"] },
            "body": { "mode": "raw", "raw": "{\n  \"method\": \"qr_payment\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const j = pm.response.json();",
                "if (j && j.data && j.data.session && j.data.session.id) pm.environment.set('payment_session_id', j.data.session.id);"
              ] }
            }
          ]
        },
        {
          "name": "Confirm Cash",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/t/{{tenant_slug}}/cashier/orders/{{order_id}}/cash", "host": ["{{base_url}}"], "path": ["api", "t", "{{tenant_slug}}", "cashier", "orders", "{{order_id}}", "cash"] }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/t/{{tenant_slug}}/reports/dashboard", "host": ["{{base_url}}"], "path": ["api", "t", "{{tenant_slug}}", "reports", "dashboard"] }
          }
        }
      ]
